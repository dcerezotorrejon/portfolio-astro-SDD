---
import { getCollection, getEntry } from "astro:content";
import FloatingNav from "../components/FloatingNav/FloatingNav";
import ExperienceHistory from "../components/ExperienceHistory.astro";
import ProfileIntroduction from "../components/ProfileIntroduction.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  assertUniqueExperienceSlugs,
  sortExperiences,
} from "../content/parsers/content";

const profileEntry = await getEntry("profile", "profile");
if (!profileEntry)
  throw new Error('The required "profile/profile" content entry is missing.');

const profile = profileEntry.data;
const experienceEntries = await getCollection("experience");
assertUniqueExperienceSlugs(experienceEntries);
const experiences = sortExperiences(experienceEntries);
---

<SiteLayout
  title={profile.seo.title}
  description={profile.seo.description}
  isHome
>
  <main class="site-container home-main">
    <ProfileIntroduction profile={profile} />
    <ExperienceHistory experiences={experiences} profile={profile} />
  </main>
  <FloatingNav sections={profile.navigation} client:load />
</SiteLayout>
