---
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import TechnologyBadges from "../../components/home/TechnologyBadges.astro";
import Button from "../../components/molecules/Button.astro";
import Heading from "../../components/molecules/Heading.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
  assertUniqueExperienceSlugs,
  formatDateRange,
  resolveCompanyIcon,
} from "../../content/parsers/content";
import type { ProfileData } from "../../content/parsers/content-schema";

interface Props {
  experience: CollectionEntry<"experience">;
  profile: ProfileData;
}

export async function getStaticPaths() {
  const experiences = await getCollection("experience");
  assertUniqueExperienceSlugs(experiences);

  const profileEntry = await getEntry("profile", "profile");
  if (!profileEntry)
    throw new Error('The required "profile/profile" content entry is missing.');

  return experiences.map((experience) => ({
    params: { slug: experience.data.slug },
    props: { experience, profile: profileEntry.data },
  }));
}

const { experience, profile } = Astro.props as Props;
const { Content } = await render(experience);
const { slug, role, company, startDate, endDate, technologies, seo } =
  experience.data;
const companyIcon = resolveCompanyIcon(experience);
---

<SiteLayout title={seo.title} description={seo.description}>
  <main class="site-container my-8">
    <article
      transition:name={`experience-transition-${slug}`}
      class="experience-card experience-detail-card w-full rounded-card border border-border bg-surface p-6"
      data-experience-slug={slug}
    >
      <header class="experience-detail-header">
        <Heading level={1} variant="display">
          {role}
        </Heading>
        <p class="company-identity flex min-w-0 items-center gap-3">
          <img
            class="company-icon size-10 shrink-0 object-contain"
            src={companyIcon.src}
            alt={companyIcon.alt}
            width="40"
            height="40"
          />
          <span>{company}</span>
        </p>
        <p>{formatDateRange(startDate, endDate)}</p>
      </header>
      <div class="experience-detail-body">
        <TechnologyBadges technologies={technologies} />
        <div class="detail-content">
          <Content />
        </div>
        <Button variant="primary" href="/#trayectoria">
          {profile.backLabel}
        </Button>
      </div>
    </article>
  </main>
</SiteLayout>

<style>
  .detail-content {
    max-width: 70ch;
    line-height: 1.75;
  }

  .detail-content h2,
  .detail-content h3 {
    margin-block-end: var(--heading-section-gap);
    color: var(--heading-section-ink);
    font-size: var(--heading-section-size);
    font-weight: var(--heading-section-weight);
    line-height: var(--heading-section-leading);
  }

  .detail-content p {
    margin-block: 0 1.25em;
  }
</style>
