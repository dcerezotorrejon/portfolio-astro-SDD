---
import type { ProfileData } from "../content/parsers/content-schema";
import Heading from "./molecules/Heading.astro";
import Button from "./molecules/Button.astro";
import Icon from "./atoms/Icon.astro";

interface Props {
  profile: ProfileData;
}

const { profile } = Astro.props;
---

<section class="profile-intro" id="inicio" aria-labelledby="profile-name">
  <img
    class="profile-image"
    src={profile.image.src}
    alt={profile.image.alt}
    width="240"
    height="240"
  />
  <div class="profile-details">
    <Heading level={1} variant="display" id="profile-name">
      {profile.name}
    </Heading>
    <p>{profile.headline}</p>
    <ul class="technology-list social-links" aria-label="Redes sociales">
      {profile.socials.map(({ platform, label, url }) => (
        <li>
          <Button variant="primary" class="gap-x-2" href={url}>
            <Icon
              name={platform}
              aria-hidden="true"
              focusable="false"
              class="text-white"
            />
            <span>{label}</span>
          </Button>
        </li>
      ))}
    </ul>
    <p class="provisional-notice">{profile.notice}</p>
  </div>
</section>
