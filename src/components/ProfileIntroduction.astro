---
import type { ProfileData } from "../lib/content-schema";

interface Props {
  profile: ProfileData;
}

const { profile } = Astro.props;
---

<section class="profile-intro" id="inicio" aria-labelledby="profile-name">
  <img
    class="profile-image"
    src={profile.image.src}
    alt={profile.image.alt}
    width="240"
    height="240"
  />
  <div class="profile-details">
    <h1 id="profile-name">{profile.name}</h1>
    <p>{profile.headline}</p>
    <ul class="technology-list social-links" aria-label="Redes sociales">
      {profile.socials.map(({ platform, label, url }) => (
        <li>
          <a class="button-link" href={url}>
            <svg
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 24 24"
              width="20"
              height="20"
            >
              {platform === "github" ? (
                <path
                  fill="currentColor"
                  d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.08c-3.1.68-3.76-1.32-3.76-1.32-.5-1.3-1.24-1.65-1.24-1.65-1.01-.7.08-.69.08-.69 1.12.08 1.71 1.15 1.71 1.15 1 .1.47 2.19 3.85 1.53.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.15a10.6 10.6 0 0 1 5.55 0c2.12-1.44 3.05-1.15 3.05-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.61 5.23-5.1 5.5.4.35.75 1.02.75 2.06v3.06c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"
                />
              ) : (
                <path
                  fill="currentColor"
                  d="M20.45 3H3.55c-.3 0-.55.25-.55.55v16.9c0 .3.25.55.55.55h16.9c.3 0 .55-.25.55-.55V3.55c0-.3-.25-.55-.55-.55ZM8.34 18H5.4V9.5h2.94V18ZM6.87 8.34a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4ZM18 18h-2.94v-4.14c0-.99-.02-2.26-1.38-2.26-1.38 0-1.59 1.08-1.59 2.19V18H9.15V9.5h2.82v1.16h.04c.39-.74 1.35-1.52 2.78-1.52 2.97 0 3.52 1.95 3.52 4.49V18Z"
                />
              )}
            </svg>
            <span>{label}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="provisional-notice">{profile.notice}</p>
  </div>
</section>
