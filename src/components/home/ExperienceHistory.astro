---
import type {
  ExperienceData,
  ProfileData,
} from "../../content/parsers/content-schema";
import {
  formatDateRange,
  resolveCompanyIcon,
} from "../../content/parsers/content";
import TechnologyBadges from "./TechnologyBadges.astro";
import Heading from "../../components/molecules/Heading.astro";
import Button from "../../components/molecules/Button.astro";

interface ExperienceRecord {
  data: ExperienceData;
}

interface Props {
  experiences: ExperienceRecord[];
  profile: ProfileData;
}

const { experiences, profile } = Astro.props;
---

<section id="trayectoria" aria-labelledby="history-heading">
  <Heading level={2} variant="section" id="history-heading">
    {profile.historyHeading}
  </Heading>
  <div class="experience-list">
    {experiences.map((experience) => {
      const { role, company, startDate, endDate, summary, technologies, slug } =
        experience.data;
      const companyIcon = resolveCompanyIcon(experience);
      const startYear = startDate.getUTCFullYear();

      return (
        <article
          class="experience-card"
          style={`view-transition-name: experience-${slug}`}
        >
          <Heading level={3} variant="card">
            {role}
          </Heading>
          <p class="company-identity">
            <img
              loading="lazy"
              class="company-icon"
              src={companyIcon.src}
              alt={companyIcon.alt}
              width="40"
              height="40"
            />
            <span>{company}</span>
          </p>
          <p>{formatDateRange(startDate, endDate)}</p>
          <p>{summary}</p>
          <TechnologyBadges technologies={technologies} />
          <Button
            variant="primary"
            href={`/experiencia/${slug}/`}
            aria-label={`${profile.moreInfoLabel} sobre ${role} en ${company} (${startYear})`}
          >
            {profile.moreInfoLabel}
          </Button>
        </article>
      );
    })}
  </div>
</section>
