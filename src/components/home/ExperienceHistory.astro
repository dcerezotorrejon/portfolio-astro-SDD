---
import type {
  ExperienceData,
  ProfileData,
} from "../../content/parsers/content-schema";
import {
  formatDateRange,
  resolveCompanyIcon,
} from "../../content/parsers/content";
import TechnologyBadges from "./TechnologyBadges.astro";
import Heading from "../../components/molecules/Heading.astro";
import Button from "../../components/molecules/Button.astro";

interface ExperienceRecord {
  data: ExperienceData;
}

interface Props {
  experiences: ExperienceRecord[];
  profile: ProfileData;
}

const { experiences, profile } = Astro.props;
---

<section id="trayectoria" aria-labelledby="history-heading">
  <Heading level={2} variant="section" id="history-heading">
    {profile.historyHeading}
  </Heading>
  <div class="experience-list grid gap-5">
    {experiences.map((experience) => {
      const { role, company, startDate, endDate, summary, technologies, slug } =
        experience.data;
      const companyIcon = resolveCompanyIcon(experience);
      const startYear = startDate.getUTCFullYear();

      return (
        <article
          transition:name={`experience-transition-${slug}`}
          class="experience-card w-full rounded-card border border-border bg-surface p-6 flex flex-col gap-5"
        >
          <header class="experience-card-header flex flex-col gap-4 min-[601px]:flex-row min-[601px]:items-start">
            <img
              loading="lazy"
              class="company-icon w-full h-auto min-[601px]:size-32 min-[601px]:aspect-square min-[601px]:shrink-0 object-contain"
              src={companyIcon.src}
              alt={companyIcon.alt}
              width="128"
              height="128"
            />
            <div class="experience-card-text flex flex-col">
              <Heading level={3} variant="card">
                {role}
              </Heading>
              <p class="company-name">{company}</p>
              <p class="experience-period">
                {formatDateRange(startDate, endDate)}
              </p>
            </div>
          </header>
          <p class="experience-summary">{summary}</p>
          <TechnologyBadges technologies={technologies} />
          <div class="flex justify-end">
            <Button
              variant="primary"
              href={`/experiencia/${slug}/`}
              aria-label={`${profile.moreInfoLabel} sobre ${role} en ${company} (${startYear})`}
            >
              {profile.moreInfoLabel}
            </Button>
          </div>
        </article>
      );
    })}
  </div>
</section>
