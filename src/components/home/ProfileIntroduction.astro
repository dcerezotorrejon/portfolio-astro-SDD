---
import { Picture } from "astro:assets";

import type { ProfileData } from "../../content/parsers/content-schema";
import Heading from "../../components/molecules/Heading.astro";
import Button from "../../components/molecules/Button.astro";
import Icon from "../../components/atoms/Icon.astro";

interface Props {
  profile: ProfileData;
}

const { profile } = Astro.props;
---

<section
  class="profile-intro flex min-h-[min(70svh,640px)] flex-col items-stretch justify-center gap-7 py-10 md:flex-row md:items-center md:justify-start md:gap-12"
  id="inicio"
  aria-labelledby="profile-name"
>
  <Picture
    pictureAttributes={{
      class:
        "shrink-0 self-center md:self-auto w-[min(200px,100%)] md:w-[240px]",
    }}
    class="profile-image aspect-square w-full rounded-card object-contain bg-surface"
    src={profile.image.src}
    alt={profile.image.alt}
    formats={["avif", "webp"]}
    widths={[200, 240, 400, 480]}
    sizes="(max-width: 767px) 200px, 240px"
    width={240}
    loading="eager"
    decoding="async"
  />
  <div class="profile-details min-w-0 text-left">
    <Heading level={1} variant="display" id="profile-name">
      {profile.name}
    </Heading>
    <p class="mt-3 mb-5">{profile.headline}</p>
    <p class="mt-3 mb-5">{profile.about}</p>
    <ul
      class="social-links mt-4 mb-5 flex list-none flex-wrap gap-2 p-0"
      aria-label="Redes sociales"
    >
      {profile.socials.map(({ platform, label, url }) => (
        <li>
          <Button variant="primary" class="gap-x-2" href={url}>
            <Icon
              name={platform}
              aria-hidden="true"
              focusable="false"
              class="text-white"
            />
            <span>{label}</span>
          </Button>
        </li>
      ))}
    </ul>
  </div>
</section>
