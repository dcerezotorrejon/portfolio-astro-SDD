---
import type { HTMLAttributes } from "astro/types";

type Props = {
  variant: "primary" | "secondary";
  href?: string;
  class?: string;
  disabled?: boolean;
} & Omit<HTMLAttributes<"a">, "class">;

const {
  variant,
  href,
  class: className,
  type = "button",
  disabled,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
const isButton = Tag === "button";

const baseClasses =
  "inline-flex min-h-11 min-w-11 items-center justify-center rounded-pill px-5 py-2.5 font-semibold leading-tight text-center no-underline transition-colors duration-control motion-reduce:transition-none";
const variantClasses = {
  primary:
    "border border-transparent bg-button text-surface hover:bg-button-hover active:bg-button-active",
  secondary:
    "border border-border bg-surface text-ink hover:bg-page active:bg-border",
}[variant];
---

<Tag
  data-molecule="button"
  data-variant={variant}
  class:list={[baseClasses, variantClasses, className]}
  href={href}
  type={isButton ? type : undefined}
  disabled={isButton ? disabled : undefined}
  {...rest}
>
  <slot />
</Tag>
