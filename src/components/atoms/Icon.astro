---
import type { HTMLAttributes } from "astro/types";
import { withBase } from "../../lib/base-url";
import { iconMap, type IconName } from "./iconMap";

type Props = {
  name: IconName;
  class?: string;
} & Omit<HTMLAttributes<"svg">, "class">;

const { name, class: className, ...rest } = Astro.props;
const href = withBase(iconMap[name]);
---

<svg class:list={["icon size-4", className]} {...rest}>
  <use href={href} />
</svg>

<style>
  @layer components {
    .icon {
      color: var(--color-primary);
    }
  }
</style>
