{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "a11y": {
        "type": "local",
        "command": ["node_modules/.bin/a11y-mcp"],
        "environment": {
          "PUPPETEER_EXECUTABLE_PATH": "/usr/bin/google-chrome"
        }
      }
    }
  },
  "providers": {
    "openrouter": {
      "models": {
        "openrouter/auto": {
          "name": "Auto Router",
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } }
          ]
        }
      }
    }
  }
}
