{
  "spec-refiner": [
    {
      "action": "edit",
      "resource": "**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "specs/*/spec.md",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "specs/_template/**",
      "effect": "deny"
    }
  ],
